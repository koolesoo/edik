# Скопируй в .env.capacitor для сборки под Capacitor/Android (не коммить секреты).
# Сборка: npm run build:capacitor
#
# Обязательно: полный URL бэкенда до префикса /api (без завершающего слэша — он подставляется в коде).
# Продакшен (HTTPS):
# VITE_API_BASE=https://your-domain.example/api
#
# Отладка в LAN по HTTP (только debug-сборка Android с cleartext — см. android/app/src/debug/):
# VITE_API_BASE=http://192.168.1.10:5001/api

VITE_API_BASE=https://your-domain.example/api
