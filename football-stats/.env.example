# Скопируй в .env при необходимости (файл .env в git не коммитится).
# Прокси dev: браузер → /api → Vite → Flask (по умолчанию http://127.0.0.1:5001).
# VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Если фронт без Vite-прокси (например статика с другого хоста), полный URL до /api:
# VITE_API_BASE=http://192.168.0.10:5001/api

# Сборка под Android (Capacitor): см. .env.capacitor.example и npm run build:capacitor
