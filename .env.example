# Вариант A: файл .env рядом с app.py (или football-stats/.env).
# Вариант B: если редактор не даёт сохранять .env — используйте livescore.local.env
#   в корне проекта или football-stats/livescore.local.env (те же имена переменных).

LIVESCORE_API_KEY=
LIVESCORE_API_SECRET=
# Необязательно: идентификатор турнира РПЛ в LiveScore API (по умолчанию 7).
# LIVESCORE_RPL_COMPETITION_ID=7

# Серверные аккаунты (PostgreSQL + JWT). Без этого вход / любимая команда через API вернут 503.
# Быстрый старт: в корне проекта выполните `docker compose up -d`, затем скопируйте этот файл в `.env`
# и задайте DATABASE_URL / JWT_SECRET (см. пароли в docker-compose.yml для образа postgres).
# DATABASE_URL=postgresql://footstat:footstat_dev_local@127.0.0.1:5432/footstat
# JWT_SECRET=случайная_строка_не_короче_16_символов
